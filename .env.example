# M-PESA STK push (Safaricom Daraja) — read by api/mpesa.js on the server only.
# These are never sent to the browser. Until every required value is set, the
# booking page keeps its "Pay with M-PESA (STK) — coming soon" button and the
# endpoint answers 501 { configured: false }.
#
# Required:
DARAJA_CONSUMER_KEY="your-daraja-consumer-key"
DARAJA_CONSUMER_SECRET="your-daraja-consumer-secret"
DARAJA_SHORTCODE="174379"                # paybill / till number
DARAJA_PASSKEY="your-daraja-stk-passkey"
DARAJA_CALLBACK_URL="https://your-domain.vercel.app/api/mpesa"   # must be https
# Optional:
DARAJA_ENV="sandbox"                     # sandbox | production

# GEMINI_API_KEY: documented for reference only. No code reads it.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
